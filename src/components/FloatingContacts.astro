---
// Плавающие контакты (только десктоп): Telegram + MAX. WhatsApp не добавляем.
import { site } from '../data/site';
---

<div class="hidden lg:flex fixed bottom-6 right-6 z-40 flex-col gap-3">
  <a
    href={site.telegram.url}
    target="_blank"
    rel="noopener"
    data-messenger="telegram"
    aria-label="Написать в Telegram"
    class="group grid h-14 w-14 place-items-center rounded-full bg-green text-ivory shadow-float transition-transform duration-200 ease-premium hover:-translate-y-0.5 hover:bg-green-2"
  >
    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M21.94 4.3 18.7 19.6c-.24 1.08-.88 1.34-1.78.83l-4.92-3.63-2.37 2.28c-.26.26-.48.48-.99.48l.35-5.02L18.1 6.9c.4-.35-.08-.55-.62-.2L6.16 13.9l-4.86-1.52c-1.06-.33-1.08-1.06.22-1.57l19-7.32c.88-.33 1.65.2 1.42 1.8Z"/>
    </svg>
  </a>
  <a
    href={site.max.url}
    target="_blank"
    rel="noopener"
    data-messenger="max"
    aria-label="Написать в MAX"
    class="group grid h-14 w-14 place-items-center rounded-full bg-bronze text-ink shadow-float transition-transform duration-200 ease-premium hover:-translate-y-0.5"
  >
    <span class="font-sans text-sm font-bold tracking-tight">MAX</span>
  </a>
</div>
