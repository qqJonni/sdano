---
// Липкая нижняя панель (только моб.): Позвонить / Telegram / Рассчитать.
import { site } from '../data/site';
---

<div class="lg:hidden fixed inset-x-0 bottom-0 z-40 border-t border-line bg-ivory/95 backdrop-blur pb-[env(safe-area-inset-bottom)]">
  <div class="grid grid-cols-3">
    <a href={site.phoneHref} class="flex flex-col items-center justify-center gap-1 py-2.5 text-ink">
      <svg class="h-5 w-5 text-green" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.6a2 2 0 0 1-.5 2.1L8 9.6a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.8.3 1.7.5 2.6.6a2 2 0 0 1 1.7 2Z"/>
      </svg>
      <span class="text-xs font-medium">Позвонить</span>
    </a>
    <a href={site.telegram.url} target="_blank" rel="noopener" data-messenger="telegram" class="flex flex-col items-center justify-center gap-1 py-2.5 border-x border-line text-ink">
      <svg class="h-5 w-5 text-green" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M21.94 4.3 18.7 19.6c-.24 1.08-.88 1.34-1.78.83l-4.92-3.63-2.37 2.28c-.26.26-.48.48-.99.48l.35-5.02L18.1 6.9c.4-.35-.08-.55-.62-.2L6.16 13.9l-4.86-1.52c-1.06-.33-1.08-1.06.22-1.57l19-7.32c.88-.33 1.65.2 1.42 1.8Z"/>
      </svg>
      <span class="text-xs font-medium">Telegram</span>
    </a>
    <a href="/#calc" class="flex flex-col items-center justify-center gap-1 py-2.5 bg-bronze text-ink">
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="4" y="2" width="16" height="20" rx="2"/>
        <path d="M8 6h8M8 10h8M8 14h3"/>
      </svg>
      <span class="text-xs font-bold">Рассчитать</span>
    </a>
  </div>
</div>
