---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';
import { getProjectPhotos } from '../lib/portfolioPhotos';

export interface Props {
  project: Project;
}

const { project } = Astro.props;
const href = `/portfolio/${project.slug}`;
const photos = getProjectPhotos(project.slug); // все фото объекта из его папки
---

<article class="pcard group">
  <!-- Слайдер фото объекта -->
  <div class="pcard__media" data-pcard data-href={href} role="link" tabindex="0" aria-label={project.title}>
    {
      photos.length > 0 ? (
        <div class="pcard__track" data-track>
          {photos.map((img, i) => (
            <div class="pcard__slide">
              <Image
                src={img}
                alt={`${project.title} — фото ${i + 1}`}
                widths={[320, 480, 640]}
                sizes="(min-width: 1024px) 360px, (min-width: 640px) 45vw, 90vw"
                loading={i === 0 ? 'eager' : 'lazy'}
                draggable={false}
                class="pcard__img"
              />
            </div>
          ))}
        </div>
      ) : (
        <img src={project.cover} alt={project.title} class="pcard__img" draggable={false} />
      )
    }

    {
      photos.length > 1 && (
        <>
          <button type="button" class="pcard__nav pcard__nav--prev" data-prev aria-label="Предыдущее фото">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <button type="button" class="pcard__nav pcard__nav--next" data-next aria-label="Следующее фото">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
          </button>
          <div class="pcard__progress" aria-hidden="true">
            <span class="pcard__progress-fill" data-fill></span>
          </div>
        </>
      )
    }
  </div>

  <!-- Текстовая часть — ссылка -->
  <a href={href} class="pcard__body">
    <div class="text-xs font-semibold uppercase tracking-wide text-bronze">{project.format} · {project.area}</div>
    <h3 class="mt-1.5 text-h3 transition-colors group-hover:text-bronze">{project.title}</h3>
    <p class="mt-1 text-sm text-muted-2">{project.district}{project.duration ? ` · ${project.duration}` : ''}</p>
  </a>
</article>

<style>
  .pcard {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--paper);
  }
  .pcard__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--ivory-2);
    cursor: pointer;
    touch-action: pan-y;              /* вертикальный скролл страницы не блокируем */
    -webkit-user-select: none;
    user-select: none;
  }
  .pcard__track {
    display: flex;
    height: 100%;
    will-change: transform;
  }
  .pcard__slide { flex: 0 0 100%; height: 100%; }
  .pcard__img { width: 100%; height: 100%; object-fit: cover; display: block; -webkit-user-drag: none; }

  .pcard__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: grid;
    place-items: center;
    width: 34px; height: 34px;
    border-radius: 999px;
    background: rgba(28, 27, 25, 0.45);
    color: var(--ivory);
    opacity: 0;
    transition: opacity 0.2s ease, background 0.2s ease;
  }
  .pcard__nav:hover { background: rgba(28, 27, 25, 0.7); }
  .pcard__nav svg { width: 18px; height: 18px; }
  .pcard__nav--prev { left: 8px; }
  .pcard__nav--next { right: 8px; }
  .pcard:hover .pcard__nav { opacity: 1; }
  /* на тач-устройствах стрелки не показываем — там свайп */
  @media (hover: none) { .pcard__nav { display: none; } }

  .pcard__progress {
    position: absolute;
    left: 10px; right: 10px; bottom: 10px;
    height: 3px;
    border-radius: 999px;
    background: rgba(246, 243, 238, 0.35);
    pointer-events: none;
  }
  .pcard__progress-fill {
    display: block;
    height: 100%;
    width: 0;
    border-radius: 999px;
    background: var(--bronze);
    transition: width 0.3s ease;
  }

  .pcard__body { display: block; padding: 1.25rem; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-pcard]').forEach((media) => {
    const track = media.querySelector<HTMLElement>('[data-track]');
    if (!track) return; // одиночное фото/плейсхолдер — слайдера нет
    const slides = Array.from(track.children);
    const n = slides.length;
    const fill = media.querySelector<HTMLElement>('[data-fill]');
    const href = media.dataset.href!;
    let idx = 0;

    function render(animate: boolean) {
      track!.style.transition = animate ? 'transform 0.35s ease' : 'none';
      track!.style.transform = `translateX(${-idx * 100}%)`;
      if (fill) fill.style.width = `${((idx + 1) / n) * 100}%`;
    }
    function go(i: number) {
      idx = Math.max(0, Math.min(n - 1, i));
      render(true);
    }

    // drag / swipe
    let dragging = false;
    let startX = 0;
    let dx = 0;
    let moved = false;
    let w = 0;

    media.addEventListener('pointerdown', (e) => {
      dragging = true;
      moved = false;
      startX = e.clientX;
      w = track!.clientWidth;
      track!.style.transition = 'none';
      media.setPointerCapture(e.pointerId);
    });
    media.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      dx = e.clientX - startX;
      if (Math.abs(dx) > 5) moved = true;
      track!.style.transform = `translateX(calc(${-idx * 100}% + ${dx}px))`;
    });
    const end = (e: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      try { media.releasePointerCapture(e.pointerId); } catch {}
      if (Math.abs(dx) > w * 0.2) go(idx + (dx < 0 ? 1 : -1));
      else render(true);
      dx = 0;
    };
    media.addEventListener('pointerup', end);
    media.addEventListener('pointercancel', end);

    // клик по фото → переход, если не было свайпа
    media.addEventListener('click', () => {
      if (!moved) window.location.assign(href);
    });
    media.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') window.location.assign(href);
      if (e.key === 'ArrowLeft') go(idx - 1);
      if (e.key === 'ArrowRight') go(idx + 1);
    });

    // стрелки и точки (не должны триггерить переход)
    const stop = (e: Event) => { e.stopPropagation(); e.preventDefault(); };
    media.querySelector('[data-prev]')?.addEventListener('click', (e) => { stop(e); go(idx - 1); });
    media.querySelector('[data-next]')?.addEventListener('click', (e) => { stop(e); go(idx + 1); });

    render(false);
  });
</script>
