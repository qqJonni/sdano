---
import '../styles/global.css';
import { organization } from '../lib/schema';

export interface Props {
  title?: string;
  description?: string;
  /** относительный путь к OG-картинке в /public, напр. '/og/main.jpg' */
  ogImage?: string;
  /** канонический путь, напр. '/uslugi/pod-klyuch' */
  path?: string;
  noindex?: boolean;
  /** тип og:website | article */
  ogType?: string;
  /** дополнительные JSON-LD объекты страницы (Service, BreadcrumbList, FAQPage…) */
  schema?: Record<string, unknown>[];
}

const {
  title = 'SDANO — ремонт квартир и домов под ключ в Перми',
  description = 'Ремонт квартир и домов под ключ в Перми. Работаем по договору, фиксированная смета, гарантия 2 года. 12 лет опыта, 150+ объектов.',
  ogImage = '/og/default.jpg',
  path,
  noindex = false,
  ogType = 'website',
  schema = [],
} = Astro.props;

const siteUrl = 'https://sdano-perm.ru';
const canonical = path ? new URL(path, siteUrl).href : new URL(Astro.url.pathname, siteUrl).href;

// JSON-LD: глобальная организация + переданные страницей объекты
const jsonld = [organization(), ...schema];

// Яндекс.Метрика — id из публичной env (не хардкодим)
const ymId = Number(import.meta.env.PUBLIC_YM_ID) || 0;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Favicon из знака бренда -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="mask-icon" href="/favicon.svg" color="#23423A" />
    <meta name="theme-color" content="#23423A" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="SDANO" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, siteUrl).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, siteUrl).href} />

    <!-- Self-host шрифтов (см. @font-face в global.css). Preload основного веса (кириллица). -->
    <link rel="preload" href="/fonts/manrope-cyrillic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/cormorant-cyrillic-600.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Schema.org JSON-LD -->
    {jsonld.map((node) => <script type="application/ld+json" set:html={JSON.stringify(node)} />)}

    <!-- Яндекс.Метрика (грузится при заданном PUBLIC_YM_ID) -->
    {
      ymId > 0 && (
        <script
          type="text/javascript"
          is:inline
          define:vars={{ ymId }}
          set:html={`
            (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
            m[i].l=1*new Date();for(var j=0;j<document.scripts.length;j++){if(document.scripts[j].src===r){return;}}
            k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
            (window,document,'script','https://mc.yandex.ru/metrika/tag.js','ym');
            ym(${ymId},'init',{defer:true,webvisor:true,clickmap:true,trackLinks:true,accurateTrackBounce:true});
          `}
        />
      )
    }
    {
      ymId > 0 && (
        <noscript>
          <div>
            <img src={`https://mc.yandex.ru/watch/${ymId}`} style="position:absolute;left:-9999px" alt="" />
          </div>
        </noscript>
      )
    }
  </head>
  <body>
    <slot name="header" />
    <main>
      <slot />
    </main>
    <slot name="footer" />
    <slot name="floating" />
  </body>
</html>
