---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingContacts from '../components/FloatingContacts.astro';
import MobileCTABar from '../components/MobileCTABar.astro';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  path?: string;
  noindex?: boolean;
}

const props = Astro.props;
---

<BaseLayout {...props}>
  <Header slot="header" />
  <slot />
  <Footer slot="footer" />
  <Fragment slot="floating">
    <FloatingContacts />
    <MobileCTABar />
  </Fragment>
</BaseLayout>

<script>
  // Аналитика кликов: телефон -> track('call'), мессенджеры -> track('messenger').
  import { track } from '../lib/track';
  document.addEventListener('click', (e) => {
    const el = (e.target as HTMLElement)?.closest('a');
    if (!el) return;
    const href = el.getAttribute('href') || '';
    if (href.startsWith('tel:')) {
      track('call', { href });
    } else if (el.dataset.messenger) {
      track('messenger', { type: el.dataset.messenger, href });
    }
  });
</script>
