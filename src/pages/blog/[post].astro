---
import type { GetStaticPaths } from 'astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import Button from '../../components/Button.astro';
import { posts } from '../../data/posts';
import { breadcrumbs, SITE_URL } from '../../lib/schema';

export const getStaticPaths = (() => {
  return posts.map((post) => ({
    params: { post: post.slug },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const fmt = (iso: string) => new Date(iso).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });

const path = `/blog/${post.slug}`;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: post.title,
    description: post.excerpt,
    datePublished: post.date,
    inLanguage: 'ru',
    mainEntityOfPage: new URL(path, SITE_URL).href,
    author: { '@type': 'Organization', name: 'SDANO' },
    publisher: { '@id': `${SITE_URL}/#organization` },
  },
  breadcrumbs([
    { name: 'Главная', path: '/' },
    { name: 'Блог', path: '/blog' },
    { name: post.title, path },
  ]),
];
---

<SiteLayout title={`${post.title} — блог SDANO`} description={post.excerpt} path={path} ogType="article" schema={schema}>
  <PageHero eyebrow={`${fmt(post.date)} · ${post.readingTime}`} title={post.title} />
  <Section bg="ivory" narrow>
    <div class="prose-links max-w-prose space-y-4 text-muted-2">
      {post.body.map((p) => (p.startsWith('## ') ? <h2 class="text-ink">{p.slice(3)}</h2> : <p>{p}</p>))}
    </div>
    <div class="mt-10 flex flex-wrap gap-4">
      <Button href="/#calc" variant="primary">Рассчитать ремонт</Button>
      <Button href="/blog" variant="secondary">Все статьи</Button>
    </div>
  </Section>
</SiteLayout>
