---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import LeadForm from '../components/LeadForm.astro';
import { site } from '../data/site';
import { breadcrumbs } from '../lib/schema';

// Адрес для метки на Яндекс.Карте
const mapAddress = 'Пермь, улица Серебристая, 7';
const mapSrc = `https://yandex.ru/map-widget/v1/?mode=search&text=${encodeURIComponent(mapAddress)}&z=17`;
---

<SiteLayout title="Контакты — SDANO, ремонт в Перми" description="Контакты SDANO: телефон, мессенджеры, город Пермь. Оставьте заявку на ремонт под ключ." path="/kontakty" schema={[breadcrumbs([{ name: 'Главная', path: '/' }, { name: 'Контакты', path: '/kontakty' }])]}>
  <PageHero eyebrow="Контакты" title="Свяжитесь с нами" subtitle={`Ремонт квартир и домов под ключ в ${site.city}. Ответим в мессенджере или перезвоним.`} />
  <Section bg="ivory">
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      <div class="rounded-card border border-line bg-paper p-6">
        <div class="text-xs font-semibold uppercase tracking-wide text-bronze">Телефон</div>
        <a href={site.phoneHref} class="mt-2 block font-display text-2xl text-ink hover:text-bronze transition-colors">{site.phone}</a>
        <p class="mt-1 text-sm text-muted-2">{site.workHours}</p>
      </div>
      <div class="rounded-card border border-line bg-paper p-6">
        <div class="text-xs font-semibold uppercase tracking-wide text-bronze">Мессенджеры</div>
        <a href={site.telegram.url} target="_blank" rel="noopener" class="mt-2 block text-ink hover:text-bronze transition-colors">Telegram {site.telegram.handle}</a>
        <a href={site.max.url} target="_blank" rel="noopener" class="mt-1 block text-ink hover:text-bronze transition-colors">MAX</a>
      </div>
      <div class="rounded-card border border-line bg-paper p-6">
        <div class="text-xs font-semibold uppercase tracking-wide text-bronze">Почта и город</div>
        <a href={`mailto:${site.email}`} class="mt-2 block text-ink hover:text-bronze transition-colors">{site.email}</a>
        <p class="mt-1 text-sm text-muted-2">{site.address}</p>
      </div>
    </div>
    <div class="mt-12 grid gap-8 lg:grid-cols-2 lg:items-start">
      <!-- Форма -->
      <div class="rounded-card border border-line bg-paper p-6 md:p-8">
        <SectionHeading title="Оставить заявку" eyebrow="Ответим сегодня" />
        <p class="mt-4 mb-5 text-sm text-muted-2">Оставьте контакты — перезвоним и поможем с расчётом.</p>
        <LeadForm formType="Форма сметы" source="kontakty" submitLabel="Отправить заявку" />
      </div>
      <!-- Карта Яндекса -->
      <div class="overflow-hidden rounded-card border border-line bg-ivory-2">
        <iframe
          src={mapSrc}
          title={`SDANO на карте — ${site.address}`}
          class="block h-full min-h-[360px] w-full lg:min-h-[440px]"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </Section>
</SiteLayout>
