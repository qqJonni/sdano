---
import type { GetStaticPaths } from 'astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import Button from '../../components/Button.astro';
import LeadForm from '../../components/LeadForm.astro';
import { services } from '../../data/services';
import { segments } from '../../data/segments';
import { service as serviceSchema, breadcrumbs, faqPage } from '../../lib/schema';

export const getStaticPaths = (() => {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}) satisfies GetStaticPaths;

const { service } = Astro.props;

const related = (service.relatedSegments ?? [])
  .map((slug) => segments.find((s) => s.slug === slug))
  .filter((s): s is (typeof segments)[number] => Boolean(s));

const path = `/uslugi/${service.slug}`;
const schema = [
  serviceSchema({
    name: service.title,
    serviceType: service.title,
    description: service.short,
    path,
    priceFrom: service.priceFrom,
  }),
  breadcrumbs([
    { name: 'Главная', path: '/' },
    { name: service.title, path },
  ]),
  ...(service.faq && service.faq.length ? [faqPage(service.faq)] : []),
];
---

<SiteLayout
  title={`${service.title} в Перми — цены, что входит | SDANO`}
  description={service.lead ?? service.description}
  path={path}
  schema={schema}
>
  <PageHero eyebrow="Услуга" title={service.title} subtitle={service.short} />

  <Section bg="ivory">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="text-lead text-ink">{service.lead ?? service.description}</p>
        {service.body && (
          <div class="mt-5 space-y-4 text-muted-2">
            {service.body.map((p) => <p>{p}</p>)}
          </div>
        )}

        <div class="mt-10">
          <h2>Что входит</h2>
          <ul class="mt-4 grid gap-2 sm:grid-cols-2">
            {service.includes.map((item) => (
              <li class="flex items-start gap-3">
                <svg class="mt-0.5 h-5 w-5 shrink-0" viewBox="0 0 64 64" fill="none" aria-hidden="true">
                  <rect x="2" y="2" width="60" height="60" rx="7" fill="#1C1B19" />
                  <path d="M18 33 L28 43 L48 20" stroke="#C7A16B" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <aside class="lg:col-span-5">
        <div class="rounded-card border border-line bg-paper p-6">
          {service.priceFrom && <div class="font-display text-3xl text-ink">{service.priceFrom}</div>}
          <p class="mt-2 text-sm text-muted-2">Точную стоимость зафиксируем в договоре после замера.</p>
          <Button href="/#calc" variant="primary" class="mt-5 w-full">Рассчитать стоимость</Button>
        </div>

        <div class="mt-5 rounded-card border border-line bg-paper p-6">
          <h3 class="text-lg">Получить смету</h3>
          <p class="mt-1 text-sm text-muted-2">Перезвоним за 15 минут и пришлём примеры работ.</p>
          <LeadForm formType="Форма сметы" source={`uslugi/${service.slug}`} class="mt-4" />
        </div>
      </aside>
    </div>
  </Section>

  {service.faq && service.faq.length > 0 && (
    <Section bg="ivory-2" title="Частые вопросы" eyebrow="FAQ" narrow>
      <div class="mt-6 divide-y divide-line">
        {service.faq.map((item) => (
          <div class="py-5">
            <h3 class="text-lg text-ink">{item.q}</h3>
            <p class="mt-2 text-muted-2">{item.a}</p>
          </div>
        ))}
      </div>
    </Section>
  )}

  {related.length > 0 && (
    <Section bg="ivory" title="Смотрите также" narrow>
      <div class="mt-4 flex flex-wrap gap-3">
        {related.map((s) => (
          <a href={`/remont/${s.slug}`} class="rounded-btn border border-line bg-paper px-4 py-2 text-sm text-ink hover:border-bronze">
            {s.title}
          </a>
        ))}
        <a href="/portfolio" class="rounded-btn border border-line bg-paper px-4 py-2 text-sm text-ink hover:border-bronze">
          Портфолио работ
        </a>
      </div>
    </Section>
  )}
</SiteLayout>
